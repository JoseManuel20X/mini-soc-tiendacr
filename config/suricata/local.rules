# Reglas propias de Suricata - Mini SOC TiendaCR
# Archivo: /var/lib/suricata/rules/local.rules (anadir a rule-files en suricata.yaml)

# Regla 1 - Detecta inyeccion SQL (UNION ... SELECT) en la URI, en cualquier puerto.
# Responde al Ataque 3 (sqlmap). Necesaria porque DVWA corre en el puerto 8080.
alert http any any -> $HOME_NET any (msg:"CUSTOM TiendaCR SQLi UNION SELECT detectada"; flow:to_server,established; http.uri; content:"UNION"; nocase; content:"SELECT"; nocase; distance:0; classtype:web-application-attack; sid:1000001; rev:1;)

# Regla 2 - Detecta la herramienta sqlmap por su user-agent.
# Responde al Ataque 3 (explotacion web).
alert http any any -> $HOME_NET any (msg:"CUSTOM TiendaCR herramienta sqlmap detectada"; flow:to_server,established; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:1000002; rev:1;)
